/**
 * Turns ASCII art into SVG path data by outlining every glyph, so the art
 * renders exactly like monospace text without any `<text>` in the markup.
 *
 * Glyphs come from Menlo-Regular (the font Chromium on macOS resolves our
 * `font-mono` stack to), so this script only runs on macOS:
 *
 *   node scripts/generate-ascii-svg.mts
 */
import { writeFileSync } from "node:fs";
import { openSync, type Font } from "fontkit";

const FONT_PATH = "/System/Library/Fonts/Menlo.ttc";
const FONT_NAME = "Menlo-Regular";
const OUT_FILE = new URL("../src/ui/ascii-art.generated.ts", import.meta.url);

type ArtSpec = {
  art: string;
  fontSize: number;
  /** Distance between baselines. */
  lineHeight: number;
} & (
  | {
      /** Lines are centered in a fixed box, first line's baseline at `y = 0`. */
      layout: "fixed";
      width: number;
      height: number;
    }
  | {
      /** The box is cropped to the ink, plus `padding` on each side. */
      layout: "fit";
      padding: number;
    }
);

const KATTCORP_LOGO = `
             / )
 / )__/ )___/ /
( @ . @ )     )
 (           )
 //"//""//"//
 
    KATT.DEV`;

const specs: Record<string, ArtSpec> = {
  kattLogo: {
    art: KATTCORP_LOGO,
    fontSize: 14,
    lineHeight: 14,
    layout: "fixed",
    width: 136,
    height: 120,
  },
  ...Object.fromEntries(
    Object.entries({
      githubIcon: String.raw`
/\_/\
(o.o)
`,
      twitterIcon: String.raw`
\/
/\
`,
      blueskyIcon: String.raw`
(\/)
(/\)
`,
      linkedInIcon: String.raw`
[in]
`,
      emailIcon: String.raw`
 ___
|\_/|
|___|
`,
    }).map(([name, art]): [string, ArtSpec] => [
      name,
      {
        art: art.slice(1, -1),
        fontSize: 10,
        lineHeight: 8,
        layout: "fit",
        padding: 0,
      },
    ]),
  ),
};

type Box = { minX: number; minY: number; maxX: number; maxY: number };

function round(n: number) {
  return String(Math.round(n * 1000) / 1000);
}

function outline(font: Font, spec: ArtSpec) {
  const scale = spec.fontSize / font.unitsPerEm;
  const lines = spec.art.split("\n");
  const cols = Math.max(...lines.map((line) => line.length));
  const advance = font.glyphForCodePoint(0x20).advanceWidth * scale;

  const originX =
    spec.layout === "fixed" ? spec.width / 2 - (cols * advance) / 2 : 0;
  const ink: Box = {
    minX: Infinity,
    minY: Infinity,
    maxX: -Infinity,
    maxY: -Infinity,
  };

  const commands: { cmd: string; points: [number, number][] }[] = [];
  lines.forEach((line, row) => {
    const baseline = row * spec.lineHeight;
    [...line].forEach((char, col) => {
      if (char === " ") return;
      const glyph = font.glyphForCodePoint(char.codePointAt(0)!);
      if (glyph.id === 0) throw new Error(`Menlo has no glyph for "${char}"`);
      const x0 = originX + col * advance;
      const toPoint = (x: number, y: number): [number, number] => {
        const px = x0 + x * scale;
        const py = baseline - y * scale;
        ink.minX = Math.min(ink.minX, px);
        ink.maxX = Math.max(ink.maxX, px);
        ink.minY = Math.min(ink.minY, py);
        ink.maxY = Math.max(ink.maxY, py);
        return [px, py];
      };
      for (const { command, args } of glyph.path.commands) {
        const points: [number, number][] = [];
        for (let i = 0; i < args.length; i += 2) {
          points.push(toPoint(args[i]!, args[i + 1]!));
        }
        const cmd = {
          moveTo: "M",
          lineTo: "L",
          quadraticCurveTo: "Q",
          bezierCurveTo: "C",
          closePath: "Z",
        }[command];
        if (!cmd) throw new Error(`Unknown path command ${command}`);
        commands.push({ cmd, points });
      }
    });
  });

  let offsetX = 0;
  let offsetY = 0;
  let width: number;
  let height: number;
  if (spec.layout === "fixed") {
    width = spec.width;
    height = spec.height;
  } else {
    offsetX = spec.padding - ink.minX;
    offsetY = spec.padding - ink.minY;
    width = Math.ceil(ink.maxX - ink.minX + spec.padding * 2);
    height = Math.ceil(ink.maxY - ink.minY + spec.padding * 2);
  }

  const d = commands
    .map(
      ({ cmd, points }) =>
        cmd +
        points
          .map(([x, y]) => `${round(x + offsetX)} ${round(y + offsetY)}`)
          .join(" "),
    )
    .join("");

  return { width, height, d };
}

const font = openSync(FONT_PATH, FONT_NAME) as Font;
if (font.postscriptName !== FONT_NAME) {
  throw new Error(`Expected ${FONT_NAME}, got ${font.postscriptName}`);
}

const output = Object.entries(specs)
  .map(([name, spec]) => {
    const { width, height, d } = outline(font, spec);
    return `export const ${name}: AsciiArt = {\n  width: ${width},\n  height: ${height},\n  d: "${d}",\n};\n`;
  })
  .join("\n");

writeFileSync(
  OUT_FILE,
  `// Generated by scripts/generate-ascii-svg.mts. Do not edit.\n\nexport type AsciiArt = { width: number; height: number; d: string };\n\n${output}`,
);
console.log(`Wrote ${OUT_FILE.pathname}`);
